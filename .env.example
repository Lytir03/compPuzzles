# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; .env.example is tracked so the required variables are documented.

# Local Postgres (docker compose up -d), matches docker-compose.yml
DATABASE_URL="postgresql://comppuzzles:comppuzzles_dev_password@localhost:5432/comppuzzles"

# Clerk — create an application at https://dashboard.clerk.com and paste its
# API keys here. There is no way to provision these automatically.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

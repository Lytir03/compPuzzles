# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; .env.example is tracked so the required variables are documented.

# Local Postgres (docker compose up -d), matches docker-compose.yml
DATABASE_URL="postgresql://comppuzzles:comppuzzles_dev_password@localhost:5432/comppuzzles"

# Clerk was deferred in favor of a local username-only session for this
# local-only build — see auth/session.ts and CLAUDE.md's Tech stack section.
# When Clerk is reintroduced, its publishable/secret keys will go here.

# HMAC key for signing the session cookie and the Socket.IO handshake token
# (lib/signedToken.ts). Optional locally — a public dev fallback is used when
# unset — but REQUIRED outside development, where startup fails without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=""

# Realtime (Socket.IO) — separate process, see `npm run realtime`.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_PORT="4000"
RECONNECT_GRACE_MS="30000"

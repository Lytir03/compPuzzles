# Copy to .env.local. Never commit real credentials.

# ---------------------------------------------------------------------------
# Shared local application URLs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_INTERNAL_URL="http://localhost:4000"
APP_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase CLI local stack. Copy the publishable/anon value printed by
# `npx supabase start`. This is deliberately server-side despite being a
# publishable key; never configure a service-role/secret key in the web app.
SUPABASE_URL="http://127.0.0.1:55321"
SUPABASE_PUBLISHABLE_KEY="copy-from-supabase-start"

# Local-only: enables a "skip login" button on /sign-in that creates and signs
# into a fixed test account via the Supabase admin API, bypassing the
# verification-email flow. Requires the service-role key from
# `npx supabase status`. Never set either value outside local development;
# devBypassSignIn() also refuses to run when NODE_ENV=production.
DEV_AUTH_BYPASS="false"
SUPABASE_SERVICE_ROLE_KEY=""

# Prisma and the standalone realtime process use Postgres directly. Production
# Netlify must NOT receive DATABASE_URL. Railway uses a dedicated restricted
# comppuzzles_realtime role rather than this local owner connection.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
DATABASE_POOL_MAX="5"

# Auth policy/version stored with acceptance records.
CURRENT_TERMS_VERSION="2026-08-17"

# Cloudflare Turnstile. Local development may bypass server verification only
# with both flags below; production validation requires a real site/secret pair
# and the exact production hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_EXPECTED_HOSTNAME="localhost"
TURNSTILE_DEV_BYPASS="true"
AUTH_DEV_ALLOW_IN_MEMORY_RATE_LIMIT="true"
AUTH_FLOW_HMAC_SECRET="replace-with-32-plus-random-bytes-in-production"

# Shared only between the Netlify BFF and Railway. It authenticates the
# server-to-server practice assignment endpoint; never expose it as NEXT_PUBLIC_*.
PRACTICE_API_SECRET="replace-with-32-plus-random-bytes-in-production"

# Upstash is mandatory in production and optional in local development.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REALTIME_REDIS_KEY_SECRET="replace-with-32-plus-random-bytes-in-production"
AUTH_REVOCATION_TTL_SECONDS="604800"

# Generate an Ed25519 pair locally with:
#   openssl genpkey -algorithm ED25519 -out /tmp/comppuzzles-private.pem
#   openssl pkey -in /tmp/comppuzzles-private.pem -pubout -out /tmp/comppuzzles-public.pem
# Store PEM line breaks as literal \n characters in environment dashboards.
# The private key belongs only on Netlify; the JSON public-key map belongs only
# on Railway. Local .env.local may contain both.
REALTIME_JWS_PRIVATE_KEY=""
REALTIME_JWS_PUBLIC_KEYS='{"local-2026-08":""}'
REALTIME_JWS_KEY_ID="local-2026-08"
REALTIME_JWS_ISSUER="http://localhost:3000"
REALTIME_JWS_AUDIENCE="comppuzzles-realtime"

# Realtime service. REALTIME_ALLOWED_ORIGINS is a CSV of exact origins.
REALTIME_PORT="4000"
REALTIME_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RECONNECT_GRACE_MS="30000"

# Demo-only ranked matchmaking bot fallback (realtime/bot.ts). Always off in
# production regardless of this flag. Requires `npm run db:seed` to have
# created the bot account once locally.
MATCHMAKING_BOT_FALLBACK_ENABLED="false"
MATCHMAKING_BOT_FALLBACK_DELAY_MS="10000"
MATCHMAKING_BOT_USERNAME="puzzle_bot"

# Security headers. Keep report-only while developing; the production launch
# validator requires CSP_ENFORCE=true after an end-to-end smoke test.
CSP_ENFORCE="false"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="local"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
NEXT_PUBLIC_SENTRY_TUNNEL_ORIGIN=""

# Advertising is disabled for public beta. Placeholders are visual-only,
# development-only and make no network requests.
ADS_ENABLED="false"
ADS_PLACEHOLDERS_ENABLED="false"

# Public legal/contact values. Production validation rejects missing values.
LEGAL_CONTROLLER_NAME=""
LEGAL_CONTROLLER_COUNTRY="Italy"
LEGAL_LAST_UPDATED="17 August 2026"
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_SECURITY_EMAIL=""

# Backup jobs belong in the protected GitHub `production-backup` environment,
# not Netlify/Railway or a normal developer .env.local:
# BACKUP_DATABASE_URL=""
# BACKUP_AGE_RECIPIENT="age1..."
# R2_BUCKET=""
# R2_ENDPOINT_URL="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# R2_BACKUP_PREFIX="comppuzzles/database"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

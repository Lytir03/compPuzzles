FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm run db:generate

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --ignore-scripts

FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runtime

ENV NODE_ENV=production
ENV REALTIME_PORT=4000
WORKDIR /app

COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json tsconfig.json ./
COPY --chown=node:node auth ./auth
COPY --chown=node:node database ./database
COPY --from=build --chown=node:node /app/database/generated ./database/generated
COPY --chown=node:node games ./games
COPY --chown=node:node lib ./lib
COPY --chown=node:node matchmaking ./matchmaking
COPY --chown=node:node rating ./rating
COPY --chown=node:node realtime ./realtime

USER node
EXPOSE 4000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-${REALTIME_PORT:-4000}}/health/ready" >/dev/null || exit 1

CMD ["./node_modules/.bin/tsx", "realtime/server.ts"]

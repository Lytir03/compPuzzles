{
  "name": "comppuzzles",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:realtime": "tsx watch realtime/server.ts",
    "setup:local": "node scripts/setup-local-env.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "realtime": "tsx watch realtime/server.ts",
    "realtime:start": "tsx realtime/server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth-e2e": "node scripts/test-auth-policy.mjs",
    "test:ranked-e2e": "tsx scripts/test-ranked-loop.ts",
    "test:rls": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:seed": "tsx database/seed.ts",
    "schema:check": "scripts/check-schema-authority.sh",
    "security:sql": "scripts/check-unsafe-sql.sh",
    "security:secrets": "scripts/scan-secrets.sh",
    "validate:production": "node scripts/validate-production-env.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "jose": "^6.2.9",
    "next": "16.4.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
